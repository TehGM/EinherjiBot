@using TehGM.EinherjiBot.UI.Layouts
@using Microsoft.AspNetCore.Components.Authorization

<CascadingAuthenticationState>
        <Router AppAssembly="@typeof(Routes).Assembly" NotFoundPage="typeof(Pages.NotFound)">
            <Found Context="routeData">
                <PolicyAuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                    <NotAuthorized>
                        <ClientOnly>
                            Not authorized!
                        </ClientOnly>
                        <ServerOnly>
                            Refreshing login..
                        </ServerOnly>
                    </NotAuthorized>
                    <Authorizing>
                        Logging you in...
                    </Authorizing>
                </PolicyAuthorizeRouteView>
            </Found>
        </Router>
</CascadingAuthenticationState>
